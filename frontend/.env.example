# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Location: client/.env.example -> Copy to client/.env
# ==============================================================================

# Network Service Binding Endpoints
# Points your React hooks and Axios instances to the Express Server API
VITE_API_URL=http://localhost:5000

# WebSocket Gateway Connection
# Points your Socket.io-client manager to the running Node/Socket.io engine
VITE_SOCKET_URL=http://localhost:5000