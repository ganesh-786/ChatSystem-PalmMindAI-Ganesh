# =======================================================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to backend/.env and update values before running
# =======================================================================

# Server Instance Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace with your MongoDB Atlas or local MongoDB connection string
MONGO_URI=mongodb://localhost:27017/palmmindai

# Security & Session Infrastructure
JWT_SECRET=your_super_secure_jwt_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend client URL for CORS
CLIENT_URL=http://localhost:3100
