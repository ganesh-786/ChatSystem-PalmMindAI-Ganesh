# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# Location: server/.env.example -> Copy to server/.env
# ==============================================================================

# Server Instance Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace with your local mongo instance string or MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/chat_application_db

# Security & Session Infrastructure
# Secure your JWT strings using a high-entropy string in production
JWT_SECRET=your_super_cryptographically_secure_secret_key_here
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS) Allow-list
# This must exactly match the URI where your local Vite/React app runs
CLIENT_URL=http://localhost:3100